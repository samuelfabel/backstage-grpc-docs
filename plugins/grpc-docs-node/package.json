{
  "name": "@samuelfabel/plugin-grpc-docs-node",
  "description": "Backstage-agnostic gRPC engine used by the grpc-docs backend (JSON in/out, reflection, unary)",
  "version": "0.1.0",
  "backstage": {
    "role": "node-library",
    "pluginId": "grpc-docs",
    "pluginPackages": [
      "@samuelfabel/plugin-grpc-docs",
      "@samuelfabel/plugin-grpc-docs-backend",
      "@samuelfabel/plugin-grpc-docs-common",
      "@samuelfabel/plugin-grpc-docs-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/samuelfabel/backstage-grpc-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelfabel/backstage-grpc-docs",
    "directory": "plugins\\grpc-docs-node"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start:hello": "yarn node ./src/test/helpers/helloServer.cjs",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.0",
    "@samuelfabel/plugin-grpc-docs-common": "workspace:^",
    "grpc-js-reflection-client": "^1.4.1",
    "protobufjs": "^8.6.5"
  },
  "devDependencies": {
    "@backstage/cli": "^0.33.0",
    "@grpc/reflection": "^1.0.4"
  }
}
