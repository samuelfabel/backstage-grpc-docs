{
  "name": "@samuelfabel/plugin-grpc-docs-backend",
  "description": "Backstage backend plugin for grpc-docs — proxy unary/streaming calls via the node engine",
  "version": "0.1.0",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "grpc-docs",
    "pluginPackages": [
      "@samuelfabel/plugin-grpc-docs",
      "@samuelfabel/plugin-grpc-docs-backend",
      "@samuelfabel/plugin-grpc-docs-common",
      "@samuelfabel/plugin-grpc-docs-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/samuelfabel/backstage-grpc-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelfabel/backstage-grpc-docs",
    "directory": "plugins\\grpc-docs-backend"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "yarn node ./dev/start.cjs",
    "start:watch": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.0",
    "@samuelfabel/plugin-grpc-docs-common": "workspace:^",
    "@samuelfabel/plugin-grpc-docs-node": "workspace:^",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.13.0",
    "@backstage/backend-test-utils": "^1.3.0",
    "@backstage/cli": "^0.33.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
