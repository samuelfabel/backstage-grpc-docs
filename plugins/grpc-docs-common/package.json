{
  "name": "@samuelfabel/plugin-grpc-docs-common",
  "description": "Common isomorphic types and utilities for the grpc-docs plugin",
  "version": "0.1.0",
  "backstage": {
    "role": "common-library",
    "pluginId": "grpc-docs",
    "pluginPackages": [
      "@samuelfabel/plugin-grpc-docs",
      "@samuelfabel/plugin-grpc-docs-backend",
      "@samuelfabel/plugin-grpc-docs-common",
      "@samuelfabel/plugin-grpc-docs-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/samuelfabel/backstage-grpc-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelfabel/backstage-grpc-docs",
    "directory": "plugins/grpc-docs-common"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.33.0"
  }
}
