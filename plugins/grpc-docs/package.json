{
  "name": "@samuelfabel/plugin-grpc-docs",
  "description": "Backstage frontend plugin — gRPC playground widget for API entities (spec.type: grpc)",
  "version": "0.1.0",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "grpc-docs",
    "pluginPackages": [
      "@samuelfabel/plugin-grpc-docs",
      "@samuelfabel/plugin-grpc-docs-backend",
      "@samuelfabel/plugin-grpc-docs-common",
      "@samuelfabel/plugin-grpc-docs-node"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/samuelfabel/backstage-grpc-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelfabel/backstage-grpc-docs",
    "directory": "plugins\\grpc-docs"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
